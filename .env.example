# Resend API key for portfolio contact form email delivery
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email address where contact messages will be delivered
CONTACT_EMAIL=ABC@XYZ.com

# Sender email address (defaults to onboarding@resend.dev during testing; update after domain verification)
CONTACT_FROM_EMAIL=onboarding@resend.dev
